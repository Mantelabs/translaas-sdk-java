<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.mantelabs</groupId>
    <artifactId>translaas-sdk-parent</artifactId>
    <version>0.4.0-beta</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>translaas-sdk-client</artifactId>
  <name>Translaas SDK Client</name>
  <description>HTTP client and JSON mapping for the Translaas API</description>

  <properties>
    <!-- JaCoCo gate for this module only (line coverage on bundle); raise as coverage improves. -->
    <translaas.jacoco.client.line.minimum>0.75</translaas.jacoco.client.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.mantelabs</groupId>
      <artifactId>translaas-sdk-models</artifactId>
    </dependency>
    <dependency>
      <groupId>io.mantelabs</groupId>
      <artifactId>translaas-sdk-caching</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${translaas.jacoco.client.line.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
